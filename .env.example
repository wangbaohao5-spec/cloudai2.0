DEEPSEEK_API_KEY=

# OpenAI-compatible 文本模型基础配置。模型名请填写当前 API 或中转平台实际支持的 model id。
OPENAI_TEXT_API_KEY=
OPENAI_TEXT_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=

# 默认文本模型：用于未单独配置的普通文本任务。
# 不要假设某个 provider 一定更便宜，请根据实际价格、效果和稳定性选择。
TEXT_PROVIDER=
TEXT_MODEL=

# 创作助手文本模型：未配置时继承 TEXT_PROVIDER / TEXT_MODEL。
CHAT_TEXT_PROVIDER=
CHAT_TEXT_MODEL=

# 创意文案模型：适合独立文案、商品文案，可以选择更发散的模型。
COPYWRITING_TEXT_PROVIDER=
COPYWRITING_TEXT_MODEL=

# 商品文案模型：可与独立文案共用，也可单独配置。
PRODUCT_COPYWRITING_TEXT_PROVIDER=
PRODUCT_COPYWRITING_TEXT_MODEL=

# 稳定规划模型：适合详情页规划，优先稳定、结构化和商品保真。
DETAIL_PAGE_PLAN_TEXT_PROVIDER=
DETAIL_PAGE_PLAN_TEXT_MODEL=

# 稳定规划模型：适合套图规划，减少发散和重复，优先保留商品细节。
IMAGE_SET_PLAN_TEXT_PROVIDER=
IMAGE_SET_PLAN_TEXT_MODEL=

# 多语言文本模型：当 outputLanguage 不是 zh-CN 时使用。
# 适合英文、日文等输出任务，可配置为更强多语言模型。
MULTILINGUAL_TEXT_PROVIDER=openai-compatible
MULTILINGUAL_TEXT_MODEL=your-multilingual-model

# 低成本模型未来可以单独接入，不应直接由 provider 名称推断成本。

AUTH_SECRET=
DASHSCOPE_API_KEY=
DASHSCOPE_VIDEO_MODEL=
RUN_API_KEY=
RUN_API_BASE_URL=

# Gemini Image experimental provider.
# GEMINI_IMAGE_BASE_URL 可选；不配置时使用 Gemini 默认 endpoint。
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_BASE_URL=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# 全局图片编辑模型。用于通用 image edit 和未单独配置的 Product 图片任务。
IMAGE_EDIT_PROVIDER=run-api
IMAGE_EDIT_MODEL=gpt-image-2

# Product Workspace 商品原图优化。
PRODUCT_IMAGE_EDIT_PROVIDER=run-api
PRODUCT_IMAGE_EDIT_MODEL=gpt-image-2

# Product Workspace 场景图。
SCENE_IMAGE_PROVIDER=run-api
SCENE_IMAGE_MODEL=gpt-image-2

# Product Workspace 详情页图片。
DETAIL_PAGE_IMAGE_PROVIDER=run-api
DETAIL_PAGE_IMAGE_MODEL=gpt-image-2

# Product Workspace 商品套图图片。
IMAGE_SET_IMAGE_PROVIDER=run-api
IMAGE_SET_IMAGE_MODEL=gpt-image-2

# 这些配置用于 image edit 类任务。默认保持 RunAPI gpt-image-2，
# 后续可将单个任务切换到 Banana 或其它实验 provider。
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
