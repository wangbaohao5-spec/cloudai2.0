DEEPSEEK_API_KEY=

# OpenAI-compatible 文本模型基础配置。模型名请填写当前 API 或中转平台实际支持的 model id。
OPENAI_TEXT_API_KEY=
OPENAI_TEXT_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=

# 默认文本模型：用于未单独配置的普通文本任务。
# 不要假设某个 provider 一定更便宜，请根据实际价格、效果和稳定性选择。
TEXT_PROVIDER=
TEXT_MODEL=

# 创意文案模型：适合独立文案、商品文案，可以选择更发散的模型。
COPYWRITING_TEXT_PROVIDER=
COPYWRITING_TEXT_MODEL=

# 商品文案模型：可与独立文案共用，也可单独配置。
PRODUCT_COPYWRITING_TEXT_PROVIDER=
PRODUCT_COPYWRITING_TEXT_MODEL=

# 稳定规划模型：适合详情页规划，优先稳定、结构化和商品保真。
DETAIL_PAGE_PLAN_TEXT_PROVIDER=
DETAIL_PAGE_PLAN_TEXT_MODEL=

# 稳定规划模型：适合套图规划，减少发散和重复，优先保留商品细节。
IMAGE_SET_PLAN_TEXT_PROVIDER=
IMAGE_SET_PLAN_TEXT_MODEL=

# 低成本模型未来可以单独接入，不应直接由 provider 名称推断成本。

AUTH_SECRET=
DASHSCOPE_API_KEY=
DASHSCOPE_VIDEO_MODEL=
RUN_API_KEY=
RUN_API_BASE_URL=
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
